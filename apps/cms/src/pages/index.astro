---
import { getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "nachalo");
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Base title={page?.data.title ?? siteTitle} description={siteTagline}>
	{
		page ? (
			<article>
				<h1 {...page.edit.title}>{page.data.title}</h1>
				<PortableText value={page.data.content} />
			</article>
		) : (
			<p>Началната страница още не е публикувана.</p>
		)
	}
</Base>
